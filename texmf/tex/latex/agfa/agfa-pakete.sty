\NeedsTeXFormat{LaTeX2e}	%
%% -- Paketname mit Pfad (Projektordner) oder ohne (texmf)
\IfFileExists{./preamble/agfa-pakete.sty}%
  {\ProvidesPackage{./preamble/agfa-pakete}}%
  {\ProvidesPackage{agfa-pakete}}
%%

\RequirePackage[newcommands,footnotes,raggedrightboxes]{ragged2e}
	
%% -- Tabellen
\RequirePackage{% Voss, LaTeX - 6.3 - Seite 227ff	& Seite 240				
	array, 			% \begin{tabular} .. \end{tabular}   	
	booktabs}		% 
\RequirePackage{longtable}

%% -- Beschriftungen
\RequirePackage{% Voss, LaTeX - 8.6 - Seite 340ff					
	caption,			   	
	floatrow,
	subcaption}
%\floatsetup[subtable]{style=Boxed}

%% -- Mehrspaltiger Satz
\RequirePackage{% 						
	multicol,	% Voss, LaTeX - 5.15.1 - Seite 215	
	parallel	% Voss, LaTeX - 5.15.2 - Seite 216
	}

%% -- Für Bilder etc.	 	   	
\RequirePackage{%
	graphicx,		% Voss, LaTeX - 5.10.2 - Seite 174
	wrapfig,		% Voss, LaTeX - 5.10.3 - Seite 177
	cutwin			% Voss, LaTeX - 5.10.3 - Seite 178
	}

%% -- gegen alleinstehende Zeilen
\RequirePackage[all]{nowidow}		

%% -- Farbe
\RequirePackage[x11names,svgnames]{xcolor}	
	\providecolor{myblue}{rgb}{0,0,1}
	\colorlet{myred}{Red}
	\colorlet{mydarkblue}{DarkBlue}
	\colorlet{mygrey}{Grey}
	\providecolor{LGrey}{gray}{.89} 

%% -- Kennzeichnung von Änderungen
%% -- \cbstart[balkenbreite] .. \cbend; \nochangebars
\RequirePackage{changebar}

%% -- Für Kommentare anstelle von %
%% --
\RequirePackage{comment}

