%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Definitionen für AGFA-Master
%% agfa-defn.sty
%% Stand: 2026-09-24 (\P, \L, \d nur im Mathemodus umdefiniert; Text bleibt nutzbar;
%%                    \d wurde bisher von hyperref ueberschrieben;
%%                    dsfont statt bbm fuer \1)
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\NeedsTeXFormat{LaTeX2e}											
%% -- Paketname mit Pfad (Projektordner) oder ohne (texmf)
\IfFileExists{./preamble/agfa-defn.sty}%
  {\ProvidesPackage{./preamble/agfa-defn}}%
  {\ProvidesPackage{agfa-defn}}
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Initialisierungen
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%% -- var-Symbole  
%% --
\AtBeginDocument{%
%% -- Griechische Buchstaben

\let\ORGvarepsilon\varepsilon
\let\varepsilon\epsilon
\let\epsilon\ORGvarepsilon

\let\ORGvarrho\varrho
\let\varrho\rho
\let\rho\ORGvarrho

\let\ORGvartheta\vartheta
\let\vartheta\theta
\let\theta\ORGvartheta

\let\ORGvarphi\varphi
\let\varphi\phi
\let\phi\ORGvarphi

%% -- Vergleichsoperatoren

\let\ORGvarleq\leqslant
\let\leqslant\leq
\let\leq\ORGvarleq

\let\ORGvargeq\geqslant
\let\geqslant\geq
\let\geq\ORGvargeq

\let\ORGvarpreccurlyeq\preccurlyeq
\let\preccurlyeq\preceq
\let\preceq\ORGvarpreccurlyeq

%% -- Mengenoperationen

\let\setminus\smallsetminus
%% -- Potenzmenge: \P im Mathemodus; im Text bleibt \P das Absatzzeichen
\DeclareRobustCommand{\P}{\ifmmode\mathfrak{P}\else\textparagraph\fi}

%% -- Operator L(E,F)
%% -- Im Text bleibt \L das polnische \L (z.B. {\L}ojasiewicz)
\let\ORGL\L
\DeclareRobustCommand{\L}{\ifmmode\expandafter\agfa@LinMath\else\expandafter\ORGL\fi}%

%% -- Differential: \d im Mathemodus; im Text bleibt \d der Unterpunkt-Akzent
\let\ORGd\d
\DeclareRobustCommand{\d}{\ifmmode\expandafter\agfa@dmath\else\expandafter\ORGd\fi}%
}

\newcommand{\agfa@LinMath}[1]{\mathcal{L}(#1)}

%% -- Eins einer Algebra (dsfont: Vektorschrift statt Bitmap-Schrift von bbm)
\RequirePackage{dsfont}
\newcommand{\1}{\mathds{1}}
\newcommand{\e}{\mathds{1}}

%% -- Zahlen
\newcommand{\N}{\mathbb{N}}		% Natuerliche Zahlen
\newcommand{\Z}{\mathbb{Z}}		% Ganze Zahlen
\newcommand{\Q}{\mathbb{Q}}		% Rationale Zahlen
\newcommand{\R}{\mathbb{R}}		% Reelle Zahlen
\newcommand{\C}{\mathbb{C}}		% Komplexe Zahlen
\newcommand{\K}{\mathbb{K}}		% Koerperzeichen
\newcommand{\T}{\mathbb{T}}


%% -- Differential Allgemeine Abkuerzungen
\newcommand*{\diff}[1]{\mathop{}\;\mathrm{d}{#1}}	% \diff{s} = ds, 
%% -- \d{\mu} = d\mu: siehe \AtBeginDocument oben (hyperref definiert \d
%%    beim Laden neu, deshalb erst bei \begin{document} umdefinieren)
\newcommand*{\agfa@dmath}[1]{\mathop{}\;\mathrm{d}{#1}}
\newcommand*{\ds}{\mathop{}\;\mathrm{d}{s}}       	% \ds = ds, 
\newcommand*{\dg}{\mathop{}\;\mathrm{d}{g}}       	% \dg = dg, 
\newcommand*{\dt}{\mathop{}\;\mathrm{d}{t}}       	% \dt = dt, 
\newcommand*{\dx}{\mathop{}\;\mathrm{d}{x}}       	% \dx = dx, 
\newcommand*{\dy}{\mathop{}\;\mathrm{d}{y}}       	% \dy = dy, 
\newcommand*{\dr}{\mathop{}\;\mathrm{d}{r}}       	% \dx = dr, 

%% -- Inverse fuer Mengenfunktionen
\newcommand{\finv}[1]{\stackrel{-1}{#1}}  % 

%% -- Eulersche Zahl und imaginäre Einheit
\newcommand{\im}{\ensuremath{\mathrm{i}}}
\newcommand{\eu}{\ensuremath{\mathrm{e}}}
\newcommand{\iu}{\ensuremath{\mathrm{i}}}

%% -- Bezeichnungen
\newcommand*{\sig}{\operatorname{sign}}
\newcommand*{\lin}{\operatorname{lin}}
\newcommand*{\conv}{\operatorname{conv}}

%% -- Operatoren

\DeclareMathOperator{\pr}{pr}      % Projektion
\DeclareMathOperator{\tr}{Tr}      % Spur
\DeclareMathOperator{\Kern}{ker}   % Kern
\DeclareMathOperator{\Bild}{im}    % Bild
\DeclareMathOperator{\Fix}{Fix}    % Fixpunktmenge Fix(T)
%
\DeclareMathOperator{\dom}{dom} 					% Definitionsbereich
\DeclareMathOperator{\ran}{ran} 					% Bildbereich
\DeclareMathOperator{\codim}{codim}
\DeclareMathOperator{\supp}{supp}
\DeclareMathOperator{\esssup}{ess\,sup}
%% --
\endinput