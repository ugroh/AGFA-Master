%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Layout und Überschriften für AGFA-Master
%% agfa-layout.sty
%% Stand: 2026-09-24 (tocdepth absolut)
%%        2026-09-30: \ProvidesPackage{\@currpath\@currname} (Projektordner und texmf)
%%        2026-09-30: tocnumwidth der subsection 2em (zweistellige Nummern im TOC)
%%        2026-10-01: Buchklassen (scrbook/scrreprt): Kapitel I, II, ...;
%%                    TOC, Kolumnentitel und Seitenzahl auf Kapitelseiten
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\NeedsTeXFormat{LaTeX2e}	%
%% -- Paketname so, wie er geladen wurde (mit ./preamble/ oder ohne)
\ProvidesPackage{\@currpath\@currname}
%% --
\RequirePackage{ifthen}
\provideboolean{english}
\DeclareOption{english}{\setboolean{english}{true}}
\ProcessOptions\relax

\setkomafont{sectioning}{\rmfamily\bfseries} 
\addtokomafont{titlehead}{\normalfont}
\addtokomafont{title}{\let\huge\Large}
\addtokomafont{author}{\Large}
\addtokomafont{date}{\normalsize}
\addtokomafont{publishers}{\large}

%% -- 
\setcounter{tocdepth}{\subsectiontocdepth}% Keine \subsubsection im TOC

%% -- Buch oder Artikel? Abfrage ueber \chapter (scrbook, scrreprt)
\newif\ifagfa@chapter
\@ifundefined{chapter}{\agfa@chapterfalse}{\agfa@chaptertrue}

%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% -- chapter (nur Buchklassen)
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% -- Kapitel I, II, ... (im Anhang setzt \appendix A, B, ...)
%%    Sections heissen im Kapitel 1, 2, ...; Verweise darauf I.2,
%%    auf Subsections I.2.3
\ifagfa@chapter
  \renewcommand*{\thechapter}{\Roman{chapter}}
  \renewcommand*{\p@section}{\thechapter.}
  \renewcommand*{\p@subsection}{\thechapter.\thesection.}
  %% -- TOC: Kapitel fett mit Seitenzahl, Nummer mit Punkt (I.)
  \RedeclareSectionCommand[tocnumwidth=2.5em]{chapter}
  \renewcommand*{\addchaptertocentry}[2]{%
    \Ifstr{#1}{}{%
      \addtocentrydefault{chapter}{#1}{#2}%
    }{%
      \addtocentrydefault{chapter}{#1.}{#2}%
    }%
  }
\fi

%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% -- section
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\renewcommand*{\thesection}{\arabic{section}} 

%% -- TOC
\RedeclareSectionCommand[tocnumwidth=2em]{section} % TOC
%% -- Buch: Section unter den Kapiteltitel einruecken
\ifagfa@chapter
  \RedeclareSectionCommand[tocindent=2.5em]{section}
\fi
\renewcommand*{\addsectiontocentry}[2]{% Eintrag in TOC
  %% -- Halbe LZ vor jeder Section; im Buch uebernimmt das das Kapitel
  \ifagfa@chapter\else
    \addtocontents{toc}{\protect\addvspace{\protect.5\baselineskip}}%
  \fi
  \Ifstr{#1}{}{%
    \addtocentrydefault{section}{#1}{#2}%
  }{%
    \addtocentrydefault{section}{\kern1pt#1.}{\itshape #2}
  }%
}
%% --  Seitenangabe unnötig (Artikel); im Buch bleibt sie stehen
\ifagfa@chapter\else
  \addtokomafont{sectionentrypagenumber}{\color{white}}
\fi

%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% -- subsection
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\renewcommand*{\thesubsection}{\arabic{subsection}}
\renewcommand*{\subsectionformat}{\thesubsection.\enskip}% Nr. in Überschrift
% 
\RedeclareSectionCommand[%
	beforeskip	= -1.75\baselineskip,
	afterskip	= 0.25\baselineskip,
	font		= \itshape,
	tocnumwidth	= 2em	% Platz fuer zweistellige Nummern (10. usw.)
]{subsection}
\ifagfa@chapter
  \RedeclareSectionCommand[tocindent=4.5em]{subsection}% unter die Section
\fi
%% -- Eintrag in das TOC
\renewcommand*{\addsubsectiontocentry}[2]{%
  \Ifstr{#1}{}{%
    \addtocentrydefault{subsection}{#1}{#2}%
  }{%
    \addtocentrydefault{subsection}{#1.}{#2}% Mit Punkt hinter der Nummer in TOC
  }%
}


%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% -- \subsubsection: Nur Nummer 1. etc; i.a. keine Überschrift
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\setcounter{secnumdepth}{\subsubsectionnumdepth} 	% Anzeigen der subsub-nummer
\renewcommand*{\thesubsubsection}{\arabic{subsubsection}.\kern.5em} % 1.
\RedeclareSectionCommand[%
  	beforeskip	=  .25\baselineskip,	% Skip vor dem Kommando + indent
	afterskip	= -0.1em,				% Kein Skip aber Abstand
	font=\normalfont,					%  
	tocnumwidth=1.25em,					% Eintrag in TOC ist aber unterbunden
	tocindent	= 1em					%  
	]{subsubsection} 
	

%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Kopf- und Fußzeile
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\RequirePackage[automark]{scrlayer-scrpage}
%\automark[subsection]{section}
\clearpairofpagestyles
%% Kopfzeile 
\KOMAoptions{headsepline=0.8pt}
\renewcommand*{\sectionmarkformat}{}	% keine Abschnittsnummer
\renewcommand*{\subsectionmarkformat}{}	% keine UnterAbschnittsnummer
%% -- Buch: links Kapitel (I Titel), rechts Section (I.2 Titel); die
%%    Nummern helfen beim Auffinden von Verweisen wie Theorem I.2.1
\ifagfa@chapter
  \automark[section]{chapter}
  \renewcommand*{\chaptermarkformat}{\thechapter\enskip}
  \renewcommand*{\sectionmarkformat}{\thechapter.\thesection\enskip}
\fi

%% ---------------------------
%% Zweiseitig und Einseitig nach Abfrage
%% ---------------------------
\ifthenelse{\boolean{@twoside}} % 
{%% --> Zweiseitig

\ihead{\headmark} 	%% -- innen

\rohead{%% außen gerade
  \makebox[0pt][l]{%
    \makebox[\marginparsep][r]{%
      \rule[-\dp\strutbox]{1pt}{\normalbaselineskip}\nobreakspace
    }%
    \makebox[\marginparwidth][l]{\pagemark}%
  }}

\lehead{%% außen ungerade
  \makebox[0pt][r]{%
    \makebox[\marginparwidth][r]{\pagemark}%
    \makebox[\marginparsep][l]{%
      \nobreakspace\rule[-\dp\strutbox]{1pt}{\normalbaselineskip}%
    }}}

}%% <-- Ende Zweiseitig
%% 
{%% --> Einseitig
\lohead{\scshape\headmark}	% Überschrift Abschnitt
\chead{}
\rohead{%					% Seite mit Balken
  \makebox[0pt][l]{%
    \makebox[\marginparsep][r]{%
      \rule[-\dp\strutbox]{1pt}{\normalbaselineskip}\nobreakspace
    }%
    \makebox[\marginparwidth][l]{\pagemark}%
  }}
}%% <-- Ende Zweiseitig
%%
%% -- Buch: Kapitelanfangsseiten (Seitenstil plain) bekommen die
%%    Seitenzahl aussen im Fuss; sonst haetten sie gar keine
\ifagfa@chapter
  \ofoot[\pagemark]{}
\fi
\pagestyle{scrheadings}

%% --Fußnoten Nach KOMA 3.14 
%% --

\RequirePackage[newcommands,footnotes,raggedrightboxes]{ragged2e}
%% 
\deffootnote[1.5em]{1em}{1em}{%
\textsuperscript{\footnotesize(\thefootnotemark)\kern5pt}
	}
%% 
\deffootnotemark{%
\textsuperscript{\footnotesize(\thefootnotemark)}
	}
\let\raggedfootnote\raggedright

%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\endinput
