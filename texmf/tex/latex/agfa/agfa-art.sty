%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Startpaket für AGFA-Master
%% agfa-art.sty
%% Stand: 2026-09-24 (auch aus texmf nutzbar: \usepackage{agfa-art};
%%        2026-09-30: \ProvidesPackage{\@currpath\@currname} (Projektordner und texmf)
%%                    Tippfehler agfa-hyperef; etex entfernt; agfa-quellen geladen;
%%                    unbekannte Optionen werden gemeldet)
%% Literatur: Der LaTeX-Begleiter, A.4, Seite 910 ff
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Kenndaten
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\NeedsTeXFormat{LaTeX2e}											
%% -- Paketname so, wie er geladen wurde (./preamble/agfa-art oder agfa-art)
\ProvidesPackage{\@currpath\@currname}
%% -- Teilpakete auf demselben Weg laden wie agfa-art selbst:
%%    \usepackage{./preamble/agfa-art} -> alles aus ./preamble,
%%    \usepackage{agfa-art}            -> alles ueber den TeX-Suchpfad (texmf).
%%    So werden nie Dateien aus beiden Orten gemischt.
\edef\agfa@dir{\@currpath}	% "./preamble/" oder leer
\newcommand*{\agfa@load}[1]{\RequirePackage{\agfa@dir#1}}
%% -- Optionen an das Teilpaket unter demselben Namen weitergeben
\newcommand*{\agfa@pass}[2]{%
  \edef\agfa@tmp{\noexpand\PassOptionsToPackage{#1}{\agfa@dir#2}}\agfa@tmp}
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Initialisierungen
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\RequirePackage{ifthen}
	\provideboolean{numeric}
	\provideboolean{alphabetic}     
	%\provideboolean{philosophy}      
	%\provideboolean{urldoi}
 	\provideboolean{english}
 	\provideboolean{german}
	\provideboolean{refenglish}
	\provideboolean{lmodern}
	\provideboolean{libertinus}
	\provideboolean{thmframed}
	\provideboolean{framed}
	\provideboolean{review}

%%

%% -- Deklaration von Optionen
%% --

%% -- Die Klasse ist beim Laden dieses Pakets schon geladen; Klassenoptionen
%%    koennen hier nicht mehr weitergereicht werden -> nur melden.
\DeclareOption*{\PackageWarning{agfa-art}{Unbekannte Option `\CurrentOption' wird ignoriert}}

%% -- Sprache (alle english-bezogenen Aktionen zusammen)
%% --

\DeclareOption{english}{%
	\setboolean{english}{true}%
	\setboolean{refenglish}{true}%
	\agfa@pass{english}{agfa-babel}%
	\agfa@pass{english}{agfa-hyperref}%
	\agfa@pass{english}{agfa-theorem}%
	\agfa@pass{english}{agfa-biblio}%  
}

%% -- mathematische Umgebungen mit/ohne Rahmen
%% --

\DeclareOption{thmframed}{\agfa@pass{framed}{agfa-theorem}}

%% -- Schrift
%% --

\DeclareOption{lmodern}{\agfa@pass{lmodern}{agfa-font}}
\DeclareOption{libertinus}{\agfa@pass{libertinus}{agfa-font}}
\DeclareOption{lucida}{\agfa@pass{lucida}{agfa-font}}		% nur LuaLaTeX, Lucida-Schriften noetig
\DeclareOption{japanese}{\agfa@pass{japanese}{agfa-font}}	% nur LuaLaTeX (luatexja)

%% -- Bibliographie-Stile  
%% --

\DeclareOption{numeric}{\agfa@pass{numeric}{agfa-biblio}}
\DeclareOption{alphabetic}{\agfa@pass{alphabetic}{agfa-biblio}}
%\DeclareOption{philosophy}{\agfa@pass{philosophy}{agfa-biblio}}
%\DeclareOption{urldoi}{\agfa@pass{urldoi}{agfa-biblio}}

%% -- Zeilenabstand verdoppelt
%% --
\DeclareOption{review}{\setboolean{review}{true}} 

\ProcessOptions\relax

%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Laden von Paketen 
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\RequirePackage[all]{onlyamsmath}			% Fehler bei Eingabe Mathematik
\RequirePackage[l2tabu,orthodox]{nag}
\RequirePackage{etoolbox,letltxmacro,metalogo}

%% -- 
\agfa@load{agfa-font}
\agfa@load{agfa-layout}
\agfa@load{agfa-pakete}
\agfa@load{agfa-babel}
\agfa@load{agfa-listen}
%% --
\agfa@load{agfa-mathtools}
\agfa@load{agfa-theorem}
%% --
\agfa@load{agfa-defn}
\agfa@load{agfa-biblio}
%% --
\agfa@load{agfa-hyperref}
%% --
\agfa@load{agfa-abkuerz}
\agfa@load{agfa-quellen}	% \quelle{URL}, \druckequellen

%% -- Zeilenabstand für review
%% --
\ifthenelse{\boolean{review}}
{%% -- if
	\RequirePackage[doublespacing]{setspace}
 }
 {%% -- else
 }

\RequirePackage{mleftright}
\mleftright
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Automatische Klammergrößenanpassung -> 
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% WARNUNG: Macht (), [] zu aktiven Zeichen!
%% Kann in TikZ, Beamer oder anderen Paketen zu Problemen führen.
%% Quelle: DTK 1/2011 & Herbert Voß
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\makeatletter
\gdef\resetMathstrut@{%
    \setbox\z@\hbox{%
        \mathchardef\@tempa\mathcode`\!\relax%
        \def\@tempb##1"##2##3{\the\textfont"##3\char"}%
        \expandafter\@tempb\meaning\@tempa \relax
    }%
    \ht\Mathstrutbox@\ht\z@ \dp\Mathstrutbox@\dp\z@}
\makeatother

\begingroup
    \catcode`(\active \xdef({\left\string(}
    \catcode`)\active \xdef){\right\string)}
    \catcode`[\active \xdef[{\left\string[}
    \catcode`]\active \xdef]{\right\string]}
\endgroup
\mathcode`(="8000 \mathcode`)="8000
\mathcode`[="8000 \mathcode`]="8000

%% Geschweifte Klammern: Funktionieren sowohl in Mathe als auch Text
\DeclareRobustCommand{\{}{\ifmmode\left\lbrace\else\textbraceleft\fi}
\DeclareRobustCommand{\}}{\ifmmode\right\rbrace\else\textbraceright\fi}

\endinput


















